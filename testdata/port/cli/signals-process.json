    {
      "name": "events_first_vault_change",
      "args": [
        "events"
      ],
      "stdout_mode": "pipe",
      "steps": [
        {
          "op": "wait_stderr",
          "text": "MailWatcher: starting",
          "rust_settle_ms": 1500
        },
        {
          "op": "settle",
          "ms": 500
        },
        {
          "op": "write_file",
          "data": "---\ntitle: New\n---\n\nbody\n",
          "path": "vault/new.md"
        },
        {
          "op": "wait_exit"
        }
      ],
      "go_defect": "cmd/symdesk/events.go unlocks the debounce mutex without holding it, so the first filesystem event ends the Go process with `fatal error: sync: unlock of unlocked mutex` (exit 2)",
      "rust": {
        "steps": [
          {
            "op": "settle",
            "ms": 1500
          },
          {
            "op": "write_file",
            "data": "---\ntitle: New\n---\n\nbody\n",
            "path": "vault/new.md"
          },
          {
            "op": "wait_stdout",
            "text": "\"event\":\"index_updated\""
          },
          {
            "op": "signal",
            "signal": "TERM"
          }
        ],
        "exit_code": 0,
        "stdout": "{\"event\":\"index_updated\",\"path\":\"\u003cROOT\u003e/vault/new.md\",\"ts\":\"\u003cTS\u003e\"}\n",
        "stderr": "",
        "note": "Rust emits the NDJSON line the event processor produces (see event_cases) and then shuts down on SIGTERM instead of crashing."
      },
      "exit_code": 2,
      "stdout": "",
      "stderr": "fatal error: sync: unlock of unlocked mutex\n"
    },
