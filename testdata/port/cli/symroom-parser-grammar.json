          "flags": [
            {
              "name": "identity",
              "type": "string",
              "usage": "Author identity name"
            },
            {
              "name": "question",
              "type": "string",
              "usage": "Question string"
            },
            {
              "name": "run",
              "type": "string",
              "usage": "Run ID"
            },
            {
              "name": "timeout",
              "type": "duration",
              "default": "15 * time.Minute",
              "usage": "Wait timeout duration"
            }
          ]
        },
        {
          "name": "resolve",
          "usage_strings": [
            "Usage: symroom checkpoint resolve \u003ccheckpoint_id\u003e --answer \"...\" [--identity \u003cname\u003e]"
          ],
          "flags": [
            {
              "name": "answer",
              "type": "string",
              "usage": "Answer string"
            },
            {
              "name": "identity",
              "type": "string",
              "usage": "Author identity name"
            }
          ]
        }
      ]
    },
    {
