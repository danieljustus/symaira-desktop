      ]
    },
    {
      "name": "mcp",
      "description": "Run MCP server mode",
      "handler": "runMcp",
      "source": "cmd_mcp.go",
      "flags": [
        {
          "name": "artifact-root",
          "type": "string",
          "usage": "Artifact root directory"
        },
