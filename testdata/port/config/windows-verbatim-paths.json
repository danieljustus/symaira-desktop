{
  "goos": "windows",
  "goarch": "amd64",
  "go_version": "go1.26.6",
  "cases": [
    {
      "id": "drive-canonical",
      "input": "\\\\?\\C:\\root",
      "expected": "\\\\?\\C:\\root\\symdesk\\config.toml"
    },
    {
      "id": "drive-mixed-separators",
      "input": "\\\\?\\C:/root",
      "expected": "\\\\?\\C:\\root\\symdesk\\config.toml"
    },
    {
      "id": "drive-dot-and-parent",
      "input": "\\\\?\\C:\\root\\.\\nested\\..\\leaf",
      "expected": "\\\\?\\C:\\root\\leaf\\symdesk\\config.toml"
    },
    {
      "id": "drive-parent",
      "input": "\\\\?\\C:\\root\\..\\leaf",
      "expected": "\\\\?\\C:\\leaf\\symdesk\\config.toml"
    },
    {
      "id": "drive-parent-at-root",
      "input": "\\\\?\\C:\\..\\leaf",
      "expected": "\\\\?\\C:\\leaf\\symdesk\\config.toml"
    },
    {
      "id": "unc-canonical",
      "input": "\\\\?\\UNC\\server\\share\\root",
      "expected": "\\\\?\\UNC\\server\\share\\root\\symdesk\\config.toml"
    },
    {
      "id": "unc-mixed-separators",
      "input": "\\\\?\\UNC\\server\\share/root",
      "expected": "\\\\?\\UNC\\server\\share\\root\\symdesk\\config.toml"
    },
    {
      "id": "unc-parent",
      "input": "\\\\?\\UNC\\server\\share\\root\\..\\leaf",
      "expected": "\\\\?\\UNC\\server\\share\\leaf\\symdesk\\config.toml"
    },
    {
      "id": "unc-parent-at-share",
      "input": "\\\\?\\UNC\\server\\share\\..\\leaf",
      "expected": "\\\\?\\UNC\\server\\leaf\\symdesk\\config.toml"
    },
    {
      "id": "drive-slash-namespace",
      "input": "//?/C:/root",
      "expected": "\\\\?\\C:\\root\\symdesk\\config.toml"
    },
    {
      "id": "unc-slash-namespace",
      "input": "//?/UNC/server/share/root",
      "expected": "\\\\?\\UNC\\server\\share\\root\\symdesk\\config.toml"
    }
  ]
}
