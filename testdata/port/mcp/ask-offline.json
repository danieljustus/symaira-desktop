{
  "schema_version": 1,
  "cases": [
    {
      "id": "unscoped-offline-search-plan",
      "documents": [
        {
          "path": "notes/ask.md",
          "body": "---\ntitle: Ask note\ntags: [askscope]\n---\n\nThis note is selected by the tag plan."
        }
      ],
      "expected_tool": {
        "annotations": {
          "readOnlyHint": true
        },
        "description": "Asks the AI a question about the vault. Uses a local Ollama instance when configured; otherwise returns the top search results with a note that AI is not configured. The answer is returned as one aggregated text (no streaming). Pass notebook to restrict retrieval and citations to that notebook's sources instead of the whole vault.",
        "inputSchema": {
          "properties": {
            "notebook": {
              "description": "optional: notebook id or path to restrict retrieval and citations to",
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "name": "desk_ask"
      },
      "calls": [
        {
          "id": "query-lowercase",
          "arguments_json": "{\"query\":\"tag:askscope\"}",
          "expected": {
            "id": 2,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "{\"answer\":\"⚠️ **AI feature not configured.**\\n\\nSet your Ollama endpoint in Settings → AI.\\n\\nHere are the most relevant search results from your vault:\\n\\n- [[notes/ask.md]]\\n\"}",
                  "type": "text"
                }
              ],
              "isError": false
            }
          }
        },
        {
          "id": "query-uppercase",
          "arguments_json": "{\"QUERY\":\"tag:askscope\"}",
          "expected": {
            "id": 3,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "{\"answer\":\"⚠️ **AI feature not configured.**\\n\\nSet your Ollama endpoint in Settings → AI.\\n\\nHere are the most relevant search results from your vault:\\n\\n- [[notes/ask.md]]\\n\"}",
                  "type": "text"
                }
              ],
              "isError": false
            }
          }
        },
        {
          "id": "query-title-case",
          "arguments_json": "{\"Query\":\"tag:askscope\"}",
          "expected": {
            "id": 4,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "{\"answer\":\"⚠️ **AI feature not configured.**\\n\\nSet your Ollama endpoint in Settings → AI.\\n\\nHere are the most relevant search results from your vault:\\n\\n- [[notes/ask.md]]\\n\"}",
                  "type": "text"
                }
              ],
              "isError": false
            }
          }
        },
        {
          "id": "query-null",
          "arguments_json": "{\"query\":null}",
          "expected": {
            "id": 5,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "query is required",
                  "type": "text"
                }
              ],
              "isError": true
            }
          }
        },
        {
          "id": "arguments-null",
          "arguments_json": "null",
          "expected": {
            "id": 6,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "query is required",
                  "type": "text"
                }
              ],
              "isError": true
            }
          }
        },
        {
          "id": "query-wrong-type",
          "arguments_json": "{\"query\":42}",
          "expected": {
            "id": 7,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "json: cannot unmarshal number into Go struct field .query of type string",
                  "type": "text"
                }
              ],
              "isError": true
            }
          }
        },
        {
          "id": "query-whitespace",
          "arguments_json": "{\"query\":\"   \"}",
          "expected": {
            "id": 8,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "{\"answer\":\"⚠️ **AI feature not configured.**\\n\\nSet your Ollama endpoint in Settings → AI.\\n\\nHere are the most relevant search results from your vault:\\n\\n\"}",
                  "type": "text"
                }
              ],
              "isError": false
            }
          }
        },
        {
          "id": "notebook-kelvin-case",
          "arguments_json": "{\"query\":\"tag:askscope\",\"notebooK\":\"notebook-fixture\"}",
          "expected": {
            "id": 9,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "notebook not found",
                  "type": "text"
                }
              ],
              "isError": true
            }
          }
        },
        {
          "id": "notebook-wrong-type",
          "arguments_json": "{\"query\":\"tag:askscope\",\"notebook\":7}",
          "expected": {
            "id": 10,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "json: cannot unmarshal number into Go struct field .notebook of type string",
                  "type": "text"
                }
              ],
              "isError": true
            }
          }
        },
        {
          "id": "duplicate-folded-query-last-valid",
          "arguments_json": "{\"query\":\"\",\"QUERY\":\"tag:askscope\"}",
          "expected": {
            "id": 11,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "{\"answer\":\"⚠️ **AI feature not configured.**\\n\\nSet your Ollama endpoint in Settings → AI.\\n\\nHere are the most relevant search results from your vault:\\n\\n- [[notes/ask.md]]\\n\"}",
                  "type": "text"
                }
              ],
              "isError": false
            }
          }
        },
        {
          "id": "duplicate-folded-query-last-empty",
          "arguments_json": "{\"QUERY\":\"tag:askscope\",\"query\":\"\"}",
          "expected": {
            "id": 12,
            "jsonrpc": "2.0",
            "result": {
              "content": [
                {
                  "text": "query is required",
                  "type": "text"
                }
              ],
              "isError": true
            }
          }
        }
      ],
      "provider_requests": []
    }
  ]
}
