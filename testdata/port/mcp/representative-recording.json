                  "properties": {
                    "path": {
                      "description": "vault-relative meeting note path",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "type": "object"
                },
                "name": "meeting_get"
              },
              {
                "annotations": {
                  "readOnlyHint": true
                },
                "description": "Reads the full output of an externalized tool result by its handle (returned as \"[Full result externalized to \u003chandle\u003e…]\"). Use this to re-read a result that was summarized because it was large.",
                "inputSchema": {
                  "properties": {
                    "handle": {
                      "description": "the externalized-result handle from the tool output",
                      "type": "string"
                    }
                  },
                  "required": [
                    "handle"
                  ],
                  "type": "object"
                },
                "name": "desk_read_result"
              },
              {
                "annotations": {
                  "readOnlyHint": true
                },
                "description": "Lists all notebooks in the vault. A notebook is a named, bounded set of vault sources used to scope AI grounding, retrieval and generated artifacts.",
                "inputSchema": {
                  "properties": {},
                  "type": "object"
                },
                "name": "notebook_list"
              },
              {
                "annotations": {
                  "readOnlyHint": true
                },
                "description": "Gets one notebook by id or vault-relative path, including its resolved sources (path, current title, and whether the source file still exists).",
                "inputSchema": {
                  "properties": {
                    "notebook": {
                      "description": "notebook id or path",
                      "type": "string"
                    }
                  },
                  "required": [
                    "notebook"
                  ],
                  "type": "object"
                },
                "name": "notebook_get"
              },
              {
                "annotations": {
                  "readOnlyHint": true
                },
                "description": "Asks the AI a question restricted to one notebook's sources: retrieval and citations never leave the notebook's scope. Uses a local Ollama instance when configured; otherwise returns a note that AI is not configured. The answer is returned as one aggregated text (no streaming).",
                "inputSchema": {
                  "properties": {
                    "notebook": {
                      "description": "notebook id or path",
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "notebook",
                    "query"
                  ],
                  "type": "object"
                },
                "name": "notebook_ask"
              },
