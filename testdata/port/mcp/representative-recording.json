                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "columns": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "dataset": {
                      "type": "string"
                    },
                    "filter_group": {
                      "type": "object"
                    },
                    "filters": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "operator": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "key",
                          "value"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "group_by": {
                      "type": "string"
                    },
                    "limit": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "dataset"
                  ],
                  "type": "object"
                },
                "name": "desk_dataset_query"
