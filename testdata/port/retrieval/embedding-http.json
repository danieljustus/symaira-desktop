{
  "schema_version": 1,
  "cases": [
    {
      "id": "batch-with-pinned-dimensions",
      "model": "qwen3-embedding:0.6b",
      "inputs": [
        "first note",
        "second 🧪 note"
      ],
      "dimensions": 3,
      "timeout_millis": 2000,
      "response_status": 200,
      "response_body": "{\"data\":[{\"embedding\":[0.25,-0.5,1]},{\"embedding\":[2,3.5,-4]}]}",
      "expected_vectors": [
        [
          0.25,
          -0.5,
          1
        ],
        [
          2,
          3.5,
          -4
        ]
      ],
      "request_method": "POST",
      "request_path": "/v1/embeddings",
      "request_content_type": "application/json",
      "request_accept": "application/json",
      "request_body": {
        "model": "qwen3-embedding:0.6b",
        "input": [
          "first note",
          "second 🧪 note"
        ],
        "dimensions": 3
      }
    },
    {
