    {
      "id": "http-server-error",
      "model": "test-model",
      "inputs": [
        "retry is caller policy"
      ],
      "dimensions": 0,
      "timeout_millis": 2000,
      "response_status": 503,
      "response_body": "{\"error\":\"local test failure\"}",
      "expected_error_code": "provider_error",
      "expected_error_status": 503,
      "expected_error_body": "{\"error\":\"local test failure\"}",
      "expected_failure_kind": "http_status",
      "expected_retryable": true,
      "request_method": "POST",
      "request_path": "/v1/embeddings",
      "request_content_type": "application/json",
      "request_accept": "application/json",
      "request_body": {
        "model": "test-model",
        "input": [
          "retry is caller policy"
        ]
      }
    },
